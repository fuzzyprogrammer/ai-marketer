# Worker service (render-worker and others)
FROM node:20-alpine

# Install Chromium and FFmpeg
RUN apk add --no-cache chromium chromium-chromedriver ffmpeg ttf-freefont fontconfig

WORKDIR /app

COPY packages/workers/render-worker/package*.json ./
RUN npm ci --only=production

COPY packages/workers/render-worker ./

EXPOSE 3001

CMD ["node", "dist/index.js"]
